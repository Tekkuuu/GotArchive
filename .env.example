# Application Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gotarchive
VITE_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gotarchive

# Redis (ioredis — standard connection string)
# Use redis:// for plain TCP, rediss:// for TLS (required for Railway public endpoint)
REDIS_URL=redis://localhost:6379

# Authentication (better-auth)
BETTER_AUTH_SECRET=change-this-to-a-long-random-secret
BETTER_AUTH_URL=http://localhost:5173

# Logwell Logging (Application)
LOGWELL_ENDPOINT=http://localhost:5174/api/v1/ingest
LOGWELL_TOKEN=your-api-token-here
# Enable Logwell in development (set to "true" to enable)
LOGWELL_ENABLED=false
