  "views": {
    "public.anime_season_status_view": {
      "columns": {
        "anime_id": {
          "name": "anime_id",
          "type": "integer",
          "primaryKey": false,
          "notNull": true
        },
        "sequence": {
          "name": "sequence",
          "type": "integer",
          "primaryKey": false,
          "notNull": true
        },
        "status": {
          "name": "status",
          "type": "varchar",
          "primaryKey": false,
          "notNull": true
        }
      },
      "definition": "\n  SELECT\n  s.anime_id,\n  s.sequence,\n  COALESCE(\n    m.status::text,\n    CASE\n      WHEN COUNT(e.*) FILTER (WHERE e.watched) = 0\n        THEN 'Planned'\n      WHEN COUNT(e.*) FILTER (WHERE e.watched) = COUNT(e.*)\n        THEN 'Completed'\n      ELSE 'Watching'\n    END\n  ) AS status\n  FROM anime_season AS s\n  LEFT JOIN anime_season_status AS m\n    ON m.anime_id = s.anime_id\n  AND m.sequence = s.sequence\n  LEFT JOIN anime_episode AS e\n    ON e.anime_id        = s.anime_id\n  AND e.sequence = s.sequence\n  GROUP BY s.anime_id, s.sequence, m.status\n",
      "name": "anime_season_status_view",
      "schema": "public",
      "isExisting": false,
      "with": {
        "securityInvoker": true
      },
      "materialized": false
    }
  },
