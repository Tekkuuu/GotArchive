# Application Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gotarchive

# Authentication (better-auth)
BETTER_AUTH_SECRET=change-this-to-a-long-random-secret
BETTER_AUTH_URL=http://localhost:5173
# Canonical auth origin exposed to the browser (must match BETTER_AUTH_URL in prod)
PUBLIC_BETTER_AUTH_URL=http://localhost:5173

# Registration code — required to create a new account (mods only)
REGISTRATION_CODE=change-this-to-a-secret-code

# Schedule sync (cron endpoint secret — must match x-schedule-sync-episodes header)
SCHEDULE_SYNC_EPISODES=change-this-to-a-long-random-secret
