		"@sveltejs/adapter-node": "^5.2.14",
		"@types/pg": "^8.16.0",
		"better-auth": "^1.4.18",
		"cally": "^0.8.0",
		"date-fns": "^4.1.0",
		"date-fns-tz": "^3.2.0",
		"dotenv": "^16.5.0",
		"drizzle-orm": "^0.45.1",
		"fuse.js": "^7.1.0",
		"ioredis": "^5.9.3",
		"jwt-decode": "^4.0.0",
		"lodash": "^4.17.21",
		"logwell": "^0.1.11",
		"lucide-svelte": "^0.479.0",
		"marked": "^16.1.1",
		"pg": "^8.18.0",
		"postgres": "^3.4.5",
